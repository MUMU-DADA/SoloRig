<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SoloRig.Ui.Avalonia"
             x:Class="SoloRig.Ui.Avalonia.RigEditorView"
             PointerMoved="RootPointerMoved" PointerReleased="RootPointerReleased">
  <UserControl.Resources>
    <local:SkinImageConverter x:Key="SkinImageConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.srg-text">
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
    </Style>
    <Style Selector="TextBlock.srg-muted">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.srg-small">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="TextBlock.srg-eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button">
      <Setter Property="Background" Value="{DynamicResource SrgControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.srg-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgInputBrush}" />
    </Style>
    <Style Selector="Button.srg-button.primary">
      <Setter Property="Background" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.srg-button.ghost">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.srg-button.selected">
      <Setter Property="Background" Value="{DynamicResource SrgInputPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.srg-footswitch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.srg-footswitch:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.srg-input">
      <Setter Property="Background" Value="{DynamicResource SrgWindowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <Style Selector="ComboBox.srg-input">
      <Setter Property="Background" Value="{DynamicResource SrgControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Slider.srg-slider">
      <Setter Property="Background" Value="{DynamicResource SrgTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.srg-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.srg-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.srg-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Expander.srg-expander">
      <Setter Property="Background" Value="{DynamicResource SrgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
  </UserControl.Styles>

  <Border Classes="srg-window" Background="{DynamicResource SrgWindowBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1"
          CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SrgTopbarBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,0,0,1"
              Padding="18,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SrgAccentBrush}">
              <TextBlock Text="S" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="17" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="SOLORIG" Classes="srg-text" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="WHITEBOX AUDIO RIG" Classes="srg-muted" FontSize="10" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="当前工程" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding WindowTitle}" Classes="srg-text" FontSize="15" />
            <TextBlock x:Name="DocumentStatusText" Text="{Binding FileStatus}" Classes="srg-muted" FontSize="9"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}" Classes="srg-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <ComboBox Grid.Column="2" x:Name="PresetSelector" Classes="srg-input" Width="178"
                    ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName, Mode=OneWay}"
                    SelectionChanged="PresetSelectionChanged"
                    VerticalAlignment="Center" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="srg-button ghost" Content="新建" Click="NewPresetClick" />
            <Button Classes="srg-button ghost" Content="默认" Click="DefaultPresetClick" />
            <Button Classes="srg-button ghost" Content="打开" Click="OpenClick" />
            <Button Classes="srg-button ghost" Content="另存为" Click="SaveAsClick" />
            <Button Classes="srg-button primary" Content="保存" Click="SaveClick" />
            <Button x:Name="UndoButton" Classes="srg-button ghost" Content="撤销"
                    IsEnabled="{Binding CanUndo}" ToolTip.Tip="撤销（Ctrl+Z）" Click="UndoClick" />
            <Button x:Name="RedoButton" Classes="srg-button ghost" Content="重做"
                    IsEnabled="{Binding CanRedo}" ToolTip.Tip="重做（Ctrl+Y / Ctrl+Shift+Z）" Click="RedoClick" />
            <Button Classes="srg-button ghost" Content="主题" ToolTip.Tip="加载主题 JSON" Click="LoadThemeClick" />
            <Button Classes="srg-button" Content="◐" ToolTip.Tip="切换主题" Command="{Binding ToggleThemeCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="226,*,286" MinHeight="500">
        <Border Grid.Column="0" Background="{DynamicResource SrgPanelBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,0,1,0"
                Padding="15">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="模块库" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ModuleCatalogSummaryText}" Classes="srg-small" />
              </Grid>
              <TextBox Classes="srg-input" Watermark="搜索模块" Text="{Binding ModuleSearchText}" />
              <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="AnalogFilterButton" Grid.Column="0" Classes="srg-button ghost" Content="模拟" Tag="模拟"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
                <Button x:Name="DigitalFilterButton" Grid.Column="1" Classes="srg-button ghost" Content="数字" Tag="数字"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
                <Button x:Name="ExternalFilterButton" Grid.Column="2" Classes="srg-button ghost" Content="外部" Tag="外部"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
              </Grid>
              <ListBox x:Name="ModuleCatalogList" Classes="srg-list" Height="205"
                       ItemsSource="{Binding FilteredModuleCatalog}" SelectedItem="{Binding SelectedCatalogModule}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" Background="{DynamicResource SrgCardBrush}" BorderBrush="{DynamicResource SrgCardBorderBrush}" BorderThickness="1"
                            CornerRadius="7" PointerPressed="ModuleCatalogItemPointerPressed">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource SrgAccentBrush}"
                                VerticalAlignment="Center">
                          <TextBlock Text="FX" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="10" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Category}" Classes="srg-muted" FontSize="10" />
                          <TextBlock Text="{Binding Description}" Classes="srg-muted" FontSize="10"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Spacing="6">
                <Button x:Name="CatalogAddButton" Classes="srg-button primary" Content="＋ 添加所选模块"
                        Command="{Binding AddModuleCommand}" IsEnabled="{Binding CanAddModule}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="CatalogDuplicateButton" Classes="srg-button" Content="复制节点"
                          Command="{Binding DuplicateSelectedCommand}" IsEnabled="{Binding CanDuplicateSelected}" HorizontalAlignment="Stretch" />
                  <Button x:Name="CatalogDeleteButton" Classes="srg-button" Content="删除节点"
                          Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </StackPanel>
              <Border BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="资源" Classes="srg-eyebrow" />
                  <TextBlock Text="{Binding ResourceStatus}" Classes="srg-muted" FontSize="11" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="导入 NAM / A2 / IR / Circuit" Click="ImportResourceClick" />
                  <TextBlock Text="点击添加，或把模块卡片拖到画布中；画布卡片可继续拖动。"
                             Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SrgCanvasBrush}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="17,14,17,10">
              <StackPanel Spacing="2">
                <TextBlock Text="效果器链路" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="自由移动模块 · 点击两个端点建立方向连接" Classes="srg-muted" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="CanvasConnectButton" Classes="srg-button ghost" Content="连接首尾"
                        Command="{Binding ConnectSelectedCommand}" IsEnabled="{Binding CanConnectNodes}" />
                <Button x:Name="CanvasDisconnectButton" Classes="srg-button ghost" Content="断开首条"
                        Command="{Binding DisconnectSelectedCommand}" IsEnabled="{Binding CanDisconnectNodes}" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="16,0,16,14" BorderBrush="{DynamicResource SrgStrongBorderBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
              <Border.Background>
                <DynamicResource ResourceKey="SrgCanvasBackgroundBrush" />
              </Border.Background>
              <Canvas x:Name="EditorCanvas" ClipToBounds="True"
                      PointerPressed="CanvasPointerPressed" PointerMoved="CanvasPointerMoved"
                      PointerReleased="CanvasPointerReleased" SizeChanged="CanvasSizeChanged">
                <Border Canvas.Left="18" Canvas.Top="174" Width="132" Height="124" Padding="10"
                        Background="{DynamicResource SrgInputPanelBrush}" BorderBrush="{DynamicResource SrgInputBrush}" BorderThickness="1" CornerRadius="9">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="INPUT" Classes="srg-text" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="物理设备输入" Classes="srg-muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FixedInputPortText}" Classes="srg-muted" FontSize="10"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                      <Border Height="5" Background="{DynamicResource SrgTrackBrush}" CornerRadius="3" VerticalAlignment="Center">
                        <Border Width="48" HorizontalAlignment="Left" Background="{DynamicResource SrgInputBrush}" CornerRadius="3" />
                      </Border>
                      <Ellipse Grid.Column="1" Width="11" Height="11" Margin="8,0,-16,0"
                               Fill="{DynamicResource SrgInputBrush}" Stroke="{DynamicResource SrgInputOutlineBrush}" StrokeThickness="2"
                               Tag="fixed-input" PointerPressed="FixedEndpointPressed" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Canvas.Right="18" Canvas.Top="174" Width="132" Height="124" Padding="10"
                        Background="{DynamicResource SrgOutputPanelBrush}" BorderBrush="{DynamicResource SrgOutputBrush}" BorderThickness="1" CornerRadius="9">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="OUTPUT" Classes="srg-text" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="物理设备输出" Classes="srg-muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FixedOutputPortText}" Classes="srg-muted" FontSize="10"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,9,0,0">
                      <Ellipse Width="11" Height="11" Margin="-16,0,8,0"
                               Fill="{DynamicResource SrgOutputBrush}" Stroke="{DynamicResource SrgOutputOutlineBrush}" StrokeThickness="2"
                               Tag="fixed-output" PointerPressed="FixedEndpointPressed" />
                      <Border Grid.Column="1" Height="5" Background="{DynamicResource SrgTrackBrush}" CornerRadius="3" VerticalAlignment="Center">
                        <Border Width="72" HorizontalAlignment="Left" Background="{DynamicResource SrgOutputBrush}" CornerRadius="3" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>

                <Line StartPoint="150,236" EndPoint="1000,236"
                      Stroke="{DynamicResource SrgGridBrush}" StrokeThickness="1" Opacity="0.6" />
                <ItemsControl ItemsSource="{Binding CanvasConnections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Line StartPoint="{Binding SourcePoint}" EndPoint="{Binding DestinationPoint}"
                            Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="3" Opacity="0.82" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding CanvasNodes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                      <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                    </ControlTheme>
                  </ItemsControl.ItemContainerTheme>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="{Binding Width}" Height="{Binding Height}">
                        <Border Padding="11" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}"
                                BorderThickness="1" CornerRadius="10">
                          <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CategoryText}" Classes="srg-muted" FontSize="10" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="•••" Classes="srg-muted" FontSize="12" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Controls}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="9" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Width="48" Spacing="2" HorizontalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                      <Ellipse Width="29" Height="29" Fill="{DynamicResource SrgKnobBrush}"
                                               Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Border IsVisible="{Binding IsKnob}" Width="2" Height="11"
                                              Background="{DynamicResource SrgAccentBrush}" VerticalAlignment="Top"
                                              Margin="0,4,0,0" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                          <RotateTransform Angle="{Binding KnobAngle}" />
                                        </Border.RenderTransform>
                                      </Border>
                                      <Border IsVisible="{Binding IsToggle}" Width="29" Height="17"
                                              Background="{DynamicResource SrgTrackBrush}"
                                              BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1"
                                              CornerRadius="8" VerticalAlignment="Center">
                                        <Ellipse Width="11" Height="11" Fill="{DynamicResource SrgAccentBrush}"
                                                 HorizontalAlignment="Right" Margin="0,0,3,0" />
                                      </Border>
                                      <Image IsVisible="{Binding HasImage}" Width="29" Height="29"
                                             Source="{Binding ImagePath, Converter={StaticResource SkinImageConverter}}"
                                             Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" Classes="srg-muted" FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ValueText}" Classes="srg-muted" FontSize="8"
                                               HorizontalAlignment="Center" />
                                  </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                              <Button Classes="srg-footswitch" Tag="{Binding InstanceId}" Click="NodeFootswitchClick"
                                      ToolTip.Tip="切换旁路 / 启用">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Border Width="22" Height="14" Background="{DynamicResource SrgControlBrush}"
                                          BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1"
                                          CornerRadius="5" Opacity="{Binding FootswitchOpacity}">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SrgAccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <Image IsVisible="{Binding HasFootswitchImage}" Width="22" Height="14"
                                         Source="{Binding FootswitchImagePath, Converter={StaticResource SkinImageConverter}}"
                                         Stretch="Uniform" Opacity="{Binding FootswitchOpacity}" />
                                  <TextBlock Text="{Binding NodeStateText}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                                </StackPanel>
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Classes="srg-muted" FontSize="9" />
                            </Grid>
                          </Grid>
                        </Border>
                        <Ellipse Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="-7,0,0,0" Fill="{DynamicResource SrgAccentBrush}" Stroke="{DynamicResource SrgAccentOutlineBrush}" StrokeThickness="2"
                                 Tag="{Binding InstanceId}" PointerPressed="NodeInputEndpointPressed" />
                        <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,-7,0" Fill="{DynamicResource SrgOutputBrush}" Stroke="{DynamicResource SrgOutputOutlineBrush}" StrokeThickness="2"
                                 Tag="{Binding InstanceId}" PointerPressed="NodeOutputEndpointPressed" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Canvas.Left="16" Canvas.Bottom="12"
                           Text="模块可拖动 · 连接操作：先点击源输出端点，再点击目标输入端点"
                           Classes="srg-muted" FontSize="10" />
                <Border Canvas.Right="14" Canvas.Bottom="9" Background="{DynamicResource SrgOverlayBrush}" BorderBrush="{DynamicResource SrgToolBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="9,6">
                  <Button x:Name="CanvasAddModuleButton" Classes="srg-button ghost" Content="＋ 添加模块"
                          Command="{Binding AddModuleCommand}" IsEnabled="{Binding CanAddModule}" />
                </Border>
              </Canvas>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource SrgPanelBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1,0,0,0"
                Padding="15">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="模块检查器" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="拓扑编辑" Classes="srg-muted" FontSize="10" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SrgAccentBrush}">
                  <TextBlock Text="FX" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="10" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedNode.InstanceId, FallbackValue=未选择效果器}"
                             Classes="srg-text" FontSize="17" />
                  <TextBlock Text="{Binding InspectorTab} · 选择节点后在此编辑" Classes="srg-muted" FontSize="10" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,Auto">
                <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="Whitebox" Classes="srg-muted" FontSize="9" />
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="Float32" Classes="srg-muted" FontSize="9" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="实时" Foreground="{DynamicResource SrgAccentBrush}" FontSize="9" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="ParameterInspectorButton" Grid.Column="0" Classes="srg-button ghost" Content="参数" Tag="参数"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
                <Button x:Name="PortInspectorButton" Grid.Column="1" Classes="srg-button ghost" Content="端口" Tag="端口"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
                <Button x:Name="ResourceInspectorButton" Grid.Column="2" Classes="srg-button ghost" Content="资源" Tag="资源"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
              </Grid>
              <Border IsVisible="{Binding IsPortInspectorVisible}" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="连接端口" Classes="srg-muted" FontSize="10" />
                    <TextBlock Text="点击端点操作" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                  </Grid>
                  <TextBlock Text="输入 · audio / 2ch" Classes="srg-text" FontSize="11" />
                  <TextBlock Text="输出 · audio / 2ch" Classes="srg-text" FontSize="11" />
                </StackPanel>
              </Border>
              <ItemsControl x:Name="ParameterControlsList" IsVisible="{Binding IsParameterInspectorVisible}"
                            ItemsSource="{Binding SelectedParameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="7" Margin="0,3">
                      <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Id}" Classes="srg-text" FontSize="11" />
                          <TextBlock Grid.Column="1" Text="{Binding RangeText}" Classes="srg-muted" FontSize="9" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,74" Margin="0,5,0,0">
                          <Slider Classes="srg-slider" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                  Value="{Binding Value}" Tag="{Binding Target}" ValueChanged="ParameterSliderChanged" />
                          <TextBox Grid.Column="1" Classes="srg-input" Margin="7,0,0,0" Tag="{Binding Target}" Text="{Binding ValueText}"
                                   LostFocus="ParameterLostFocus" HorizontalContentAlignment="Right" FontSize="11" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Name="InspectorDuplicateButton" Classes="srg-button" Content="复制"
                        Command="{Binding DuplicateSelectedCommand}" IsEnabled="{Binding CanDuplicateSelected}" HorizontalAlignment="Stretch" />
                <Button x:Name="InspectorDeleteButton" Classes="srg-button" Content="删除"
                        Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <Border IsVisible="{Binding IsResourceInspectorVisible}" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding ResourceStatus}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="导入模块资源" Click="ImportResourceClick" />
                </StackPanel>
              </Border>

              <Expander Classes="srg-expander" Header="音频设备 / 多 ASIO 路由" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <TextBlock Text="{Binding AsioRouteText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AsioRouteValidationText}" Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="刷新 ASIO 设备" IsEnabled="{Binding CanRefreshAsio}" Click="RefreshAsioClick" />
                  <TextBlock Text="输入路由（每行可选择不同设备）" Classes="srg-muted" FontSize="9" />
                  <ItemsControl ItemsSource="{Binding AsioInputRoutes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="48,*,72">
                          <TextBlock Text="{Binding DirectionLabel}" Classes="srg-muted" FontSize="9" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DriverOptions}"
                                    SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" FontSize="10" PlaceholderText="选择设备">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" />
                                  <TextBlock Text="{Binding SampleRateText}" Classes="srg-muted" FontSize="9" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox Grid.Column="2" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DeviceChannels}"
                                    SelectedItem="{Binding SelectedDeviceChannel, Mode=TwoWay}" IsEnabled="{Binding CanEditDeviceChannel}" FontSize="10" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="输出路由（第一个输出设备作为主时钟）" Classes="srg-muted" FontSize="9" />
                  <ItemsControl ItemsSource="{Binding AsioOutputRoutes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="48,*,72">
                          <TextBlock Text="{Binding DirectionLabel}" Classes="srg-muted" FontSize="9" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DriverOptions}"
                                    SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" FontSize="10" PlaceholderText="选择设备">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" />
                                  <TextBlock Text="{Binding SampleRateText}" Classes="srg-muted" FontSize="9" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox Grid.Column="2" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DeviceChannels}"
                                    SelectedItem="{Binding SelectedDeviceChannel, Mode=TwoWay}" IsEnabled="{Binding CanEditDeviceChannel}" FontSize="10" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="打开" IsEnabled="{Binding CanOpenAsio}" Click="OpenAsioClick" />
                    <Button Classes="srg-button" Content="启动" IsEnabled="{Binding CanStartAsio}" Click="StartAsioClick" />
                    <Button Classes="srg-button" Content="停止" IsEnabled="{Binding CanStopAsio}" Click="StopAsioClick" />
                    <Button Classes="srg-button" Content="关闭" IsEnabled="{Binding CanCloseAsio}" Click="CloseAsioClick" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="恢复" IsEnabled="{Binding CanRecoverAsio}" Click="RecoverAsioClick" />
                    <Button Classes="srg-button" Content="{Binding TunerStatus}" IsEnabled="{Binding CanToggleTuner}" Click="ToggleTunerClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding TunerReadout}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>

              <Expander Classes="srg-expander" Header="MIDI 控制" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <Button Classes="srg-button" Content="刷新 MIDI 设备" IsEnabled="{Binding CanRefreshMidi}" Click="RefreshMidiClick" />
                  <ComboBox x:Name="MidiDeviceSelector" Classes="srg-input" ItemsSource="{Binding MidiDevices}"
                            SelectedIndex="{Binding SelectedMidiDeviceIndex, Mode=TwoWay}" IsEnabled="{Binding CanSelectMidiDevice}"
                            PlaceholderText="选择 MIDI 输入">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="打开" IsEnabled="{Binding CanOpenMidi}" Click="OpenMidiClick" />
                    <Button Classes="srg-button" Content="关闭" IsEnabled="{Binding CanCloseMidi}" Click="CloseMidiClick" />
                    <Button Classes="srg-button" Content="排空" IsEnabled="{Binding CanDrainMidi}" Click="DrainMidiClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding MidiLifecycleText}" Classes="srg-muted" FontSize="10" />
                  <TextBlock Text="CC Learn 目标" Classes="srg-muted" FontSize="10" />
                  <ComboBox x:Name="MidiTargetSelector" Classes="srg-input" ItemsSource="{Binding MidiLearnTargets}"
                            SelectedIndex="{Binding SelectedMidiTargetIndex, Mode=TwoWay}" IsEnabled="{Binding MidiOpen}"
                            PlaceholderText="选择要控制的参数">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="学习 CC" IsEnabled="{Binding CanArmMidiLearn}" Click="ArmMidiLearnClick" />
                    <Button Classes="srg-button" Content="取消学习" IsEnabled="{Binding CanCancelMidiLearn}" Click="CancelMidiLearnClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding MidiLearnStatus}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                  <ListBox x:Name="MidiBindingList" Classes="srg-list" Height="82" ItemsSource="{Binding MidiBindings}"
                           SelectedIndex="{Binding SelectedMidiBindingIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" /></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="DeleteMidiBindingButton" Classes="srg-button" Content="删除绑定"
                            IsEnabled="{Binding CanDeleteMidiBinding}" Click="DeleteMidiBindingClick" />
                    <Button x:Name="ClearMidiBindingsButton" Classes="srg-button" Content="清空绑定"
                            IsEnabled="{Binding CanClearMidiBindings}" Click="ClearMidiBindingsClick" />
                  </StackPanel>
                  <Button Classes="srg-button" Content="导入 MIDI Bank 目录" Click="ImportMidiBankClick" />
                </StackPanel>
              </Expander>

              <Expander Classes="srg-expander" Header="预设库" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <TextBlock Text="显式选择一个目录后，Standalone 会校验其中的 .srig 文件。"
                             Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PresetLibraryDirectoryText}" Classes="srg-muted" FontSize="9"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="选择目录" Click="LoadPresetLibraryClick" />
                    <Button Classes="srg-button" Content="刷新" IsEnabled="{Binding CanRefreshPresetLibrary}"
                            Click="RefreshPresetLibraryClick" />
                  </StackPanel>
                  <ListBox x:Name="PresetLibraryList" Classes="srg-list" Height="128"
                           ItemsSource="{Binding PresetLibraryEntries}"
                           SelectedIndex="{Binding SelectedPresetLibraryIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="7" Background="{DynamicResource SrgControlBrush}"
                                BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailText}" Classes="srg-muted" FontSize="9"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button x:Name="PresetLibraryLoadButton" Classes="srg-button primary" Content="加载选中预设"
                          IsEnabled="{Binding CanLoadSelectedPresetLibraryEntry}"
                          Click="LoadSelectedPresetLibraryClick" />
                  <TextBlock Text="Ctrl+PageUp / Ctrl+PageDown 可在已校验的预设间切换。"
                             Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>

              <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <TextBlock Text="C# 界面只负责交互与控制线程；ASIO、MIDI、实时白盒处理由原生后端执行。"
                           Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource SrgTopbarBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,1,0,0"
              Padding="18,10">
        <Grid ColumnDefinitions="1.15*,1.2*,1.05*,1.1*,1.15*">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="音频引擎" Classes="srg-eyebrow" />
            <TextBlock x:Name="AudioStatusText" Text="{Binding AudioStatus}" Classes="srg-text" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="固定路由" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding AsioRouteText}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="性能 / 延迟" Classes="srg-eyebrow" />
            <TextBlock x:Name="PerformanceText" Text="{Binding PerformanceStatus}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="2">
            <TextBlock Text="MIDI" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding MidiStatus}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="2">
            <TextBlock Text="实时白盒" Classes="srg-eyebrow" />
            <TextBlock x:Name="RealtimeStatusText" Text="{Binding RealtimeStatus}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="WhiteboxStatusText" Text="{Binding WhiteboxStatusText}" Classes="srg-muted" FontSize="9"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
