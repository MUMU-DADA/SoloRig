<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SoloRig.Ui.Avalonia"
             x:Class="SoloRig.Ui.Avalonia.RigEditorView"
             PointerMoved="RootPointerMoved" PointerReleased="RootPointerReleased"
             SizeChanged="RigEditorSizeChanged">
  <UserControl.Resources>
    <local:SkinImageConverter x:Key="SkinImageConverter" />
    <local:ConnectionGeometryConverter x:Key="ConnectionGeometryConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.srg-text">
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
    </Style>
    <Style Selector="TextBlock.srg-muted">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.srg-small">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="TextBlock.srg-eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource SrgMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button">
      <Setter Property="Background" Value="{DynamicResource SrgControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.srg-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgInputBrush}" />
    </Style>
    <Style Selector="Button.srg-button.primary">
      <Setter Property="Background" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.srg-button.ghost">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.srg-button.selected">
      <Setter Property="Background" Value="{DynamicResource SrgInputPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.srg-button.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.srg-button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.srg-endpoint">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="99" />
    </Style>
    <Style Selector="Button.srg-endpoint:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentTextBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.srg-parameter-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.srg-parameter-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource SrgControlHoverBrush}" />
    </Style>
    <Style Selector="Button.srg-parameter-chip:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
    </Style>
    <Style Selector="Button.srg-footswitch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.srg-footswitch:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.srg-input">
      <Setter Property="Background" Value="{DynamicResource SrgWindowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <Style Selector="TextBox.srg-input:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox.srg-input.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgErrorBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox.srg-input">
      <Setter Property="Background" Value="{DynamicResource SrgControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgTextBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox.srg-input:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Slider.srg-slider">
      <Setter Property="Background" Value="{DynamicResource SrgTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.srg-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.srg-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.srg-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.srg-list:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.srg-focus-surface:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Grid.srg-canvas-node:focus-visible > Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SrgAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Expander.srg-expander">
      <Setter Property="Background" Value="{DynamicResource SrgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SrgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="WrapPanel#TopbarActions > Button">
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
  </UserControl.Styles>

  <Border Classes="srg-window" Background="{DynamicResource SrgWindowBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1"
          CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SrgTopbarBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,0,0,1"
              Padding="18,12">
        <Grid x:Name="TopbarGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SrgAccentBrush}">
              <TextBlock Text="S" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="17" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="SOLORIG" Classes="srg-text" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="WHITEBOX AUDIO RIG" Classes="srg-muted" FontSize="10" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="当前工程" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding WindowTitle}" Classes="srg-text" FontSize="15" />
            <TextBlock x:Name="DocumentStatusText" Text="{Binding FileStatus}" Classes="srg-muted" FontSize="9"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}" Classes="srg-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <ComboBox Grid.Column="2" x:Name="PresetSelector" Classes="srg-input" Width="178"
                    ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName, Mode=OneWay}"
                    SelectionChanged="PresetSelectionChanged"
                    AutomationProperties.Name="当前预设"
                    VerticalAlignment="Center" />

          <WrapPanel x:Name="TopbarActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ModulePanelToggleButton" IsVisible="False" Classes="srg-button ghost" Content="模块"
                    Click="ToggleModulePanelClick" />
            <Button x:Name="InspectorPanelToggleButton" IsVisible="False" Classes="srg-button ghost" Content="检查器"
                    Click="ToggleInspectorPanelClick" />
            <Button Classes="srg-button ghost" Content="新建" Click="NewPresetClick" />
            <Button Classes="srg-button ghost" Content="默认" Click="DefaultPresetClick" />
            <Button Classes="srg-button ghost" Content="打开" Click="OpenClick" />
            <Button Classes="srg-button ghost" Content="另存为" Click="SaveAsClick" />
            <Button Classes="srg-button primary" Content="保存" Click="SaveClick" />
            <Button x:Name="UndoButton" Classes="srg-button ghost" Content="撤销"
                    IsEnabled="{Binding CanUndo}" ToolTip.Tip="撤销（Ctrl+Z）" Click="UndoClick" />
            <Button x:Name="RedoButton" Classes="srg-button ghost" Content="重做"
                    IsEnabled="{Binding CanRedo}" ToolTip.Tip="重做（Ctrl+Y / Ctrl+Shift+Z）" Click="RedoClick" />
            <Button Classes="srg-button ghost" Content="主题" ToolTip.Tip="加载主题 JSON" Click="LoadThemeClick" />
            <Button Classes="srg-button" Content="◐" ToolTip.Tip="切换主题"
                    AutomationProperties.Name="切换深浅主题" Command="{Binding ToggleThemeCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Grid x:Name="WorkspaceGrid" Grid.Row="1" MinHeight="500">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="226" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="286" />
        </Grid.ColumnDefinitions>
        <Border x:Name="ModuleLibraryPanel" Grid.Column="0" Background="{DynamicResource SrgPanelBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,0,1,0"
                Padding="15">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="模块库" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ModuleCatalogSummaryText}" Classes="srg-small" />
              </Grid>
              <TextBox Classes="srg-input" Watermark="搜索模块" Text="{Binding ModuleSearchText}"
                       AutomationProperties.Name="搜索模块" />
              <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="AnalogFilterButton" Grid.Column="0" Classes="srg-button ghost" Content="模拟" Tag="模拟"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
                <Button x:Name="DigitalFilterButton" Grid.Column="1" Classes="srg-button ghost" Content="数字" Tag="数字"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
                <Button x:Name="ExternalFilterButton" Grid.Column="2" Classes="srg-button ghost" Content="外部" Tag="外部"
                        Click="ModuleCatalogFilterClick" HorizontalContentAlignment="Center" />
              </Grid>
              <ListBox x:Name="ModuleCatalogList" Classes="srg-list" Height="205"
                       AutomationProperties.Name="模块目录"
                       ItemsSource="{Binding FilteredModuleCatalog}" SelectedItem="{Binding SelectedCatalogModule}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" Background="{DynamicResource SrgCardBrush}" BorderBrush="{DynamicResource SrgCardBorderBrush}" BorderThickness="1"
                            CornerRadius="7" PointerPressed="ModuleCatalogItemPointerPressed">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource SrgAccentBrush}"
                                VerticalAlignment="Center">
                          <TextBlock Text="FX" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="10" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Category}" Classes="srg-muted" FontSize="10" />
                          <TextBlock Text="{Binding Description}" Classes="srg-muted" FontSize="10"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Spacing="6">
                <Button x:Name="CatalogAddButton" Classes="srg-button primary" Content="＋ 添加所选模块"
                        Command="{Binding AddModuleCommand}" IsEnabled="{Binding CanAddModule}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="CatalogDuplicateButton" Classes="srg-button" Content="复制节点"
                          Command="{Binding DuplicateSelectedCommand}" IsEnabled="{Binding CanDuplicateSelected}" HorizontalAlignment="Stretch" />
                  <Button x:Name="CatalogDeleteButton" Classes="srg-button" Content="删除节点"
                          Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </StackPanel>
              <Border BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="工程节点" Classes="srg-eyebrow" />
                    <TextBlock Grid.Column="1" Text="{Binding NodeNavigatorSummaryText}" Classes="srg-small" />
                  </Grid>
                  <TextBox x:Name="NodeNavigatorSearchBox" Classes="srg-input" Watermark="搜索名称或节点 ID"
                           Text="{Binding NodeNavigatorSearchText}"
                           AutomationProperties.Name="搜索工程节点" />
                  <Grid ColumnDefinitions="*,6,*">
                    <Button x:Name="NodeNavigatorSelectAllButton" Grid.Column="0" Classes="srg-button ghost"
                            Content="全选结果" Click="NodeNavigatorSelectAllClick" />
                    <Button x:Name="NodeNavigatorClearButton" Grid.Column="2" Classes="srg-button ghost"
                            Content="清空" IsEnabled="{Binding CanBatchNodes}" Click="NodeNavigatorClearClick" />
                  </Grid>
                  <Grid ColumnDefinitions="*,6,*">
                    <Button x:Name="NodeNavigatorBypassButton" Grid.Column="0" Classes="srg-button"
                            Content="旁路" IsEnabled="{Binding CanBatchBypassNodes}" Click="NodeNavigatorBypassClick" />
                    <Button x:Name="NodeNavigatorEnableButton" Grid.Column="2" Classes="srg-button"
                            Content="启用" IsEnabled="{Binding CanBatchEnableNodes}" Click="NodeNavigatorEnableClick" />
                  </Grid>
                  <ListBox x:Name="NodeNavigatorList" Classes="srg-list" Height="168"
                           AutomationProperties.Name="工程节点列表"
                           ItemsSource="{Binding FilteredNodeNavigatorEntries}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" Margin="1,2">
                          <CheckBox Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center"
                                    IsChecked="{Binding IsBatchSelected, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding SelectionAutomationName}" />
                          <Button Grid.Column="1" Classes="srg-button ghost" Padding="7,5"
                                  HorizontalContentAlignment="Stretch" Tag="{Binding InstanceId}"
                                  Click="NodeNavigatorLocateClick" ToolTip.Tip="在画布中定位节点"
                                  AutomationProperties.Name="{Binding LocateAutomationName}">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="11"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding InstanceId}" Classes="srg-muted" FontSize="9"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Node.FootswitchText}" Classes="srg-small"
                                         VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="资源" Classes="srg-eyebrow" />
                  <TextBlock Text="{Binding ResourceStatus}" Classes="srg-muted" FontSize="11" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="导入模块资源" Click="ImportResourceClick" />
                  <TextBlock Text="点击添加，或把模块卡片拖到画布中；画布卡片可继续拖动。"
                             Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border x:Name="CanvasPanel" Grid.Column="1" Background="{DynamicResource SrgCanvasBrush}">
            <Border x:Name="CanvasSurface" Classes="srg-focus-surface" Margin="16,14"
                    BorderBrush="{DynamicResource SrgStrongBorderBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True" Focusable="True" KeyDown="CanvasSurfaceKeyDown"
                    AutomationProperties.Name="效果器画布"
                    AutomationProperties.HelpText="左右方向键选择节点，Enter 定位节点，Delete 删除节点">
              <Border.Background>
                <DynamicResource ResourceKey="SrgCanvasBackgroundBrush" />
              </Border.Background>
              <Canvas x:Name="EditorCanvas" ClipToBounds="True" PointerWheelChanged="CanvasPointerWheelChanged"
                      PointerPressed="CanvasPointerPressed" PointerMoved="CanvasPointerMoved"
                      PointerReleased="CanvasPointerReleased" SizeChanged="CanvasSizeChanged">
                <Border Canvas.Left="18" Canvas.Top="174" Width="132" Height="124" Padding="10"
                        Background="{DynamicResource SrgInputPanelBrush}" BorderBrush="{DynamicResource SrgInputBrush}" BorderThickness="1" CornerRadius="9">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="INPUT" Classes="srg-text" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="物理设备输入" Classes="srg-muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FixedInputPortText}" Classes="srg-muted" FontSize="10"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                      <Border Height="5" Background="{DynamicResource SrgTrackBrush}" CornerRadius="3" VerticalAlignment="Center">
                        <Border Width="48" HorizontalAlignment="Left" Background="{DynamicResource SrgInputBrush}" CornerRadius="3" />
                      </Border>
                      <Button Grid.Column="1" Classes="srg-endpoint" Width="13" Height="13" Margin="8,0,-16,0"
                              Background="{DynamicResource SrgInputBrush}" BorderBrush="{DynamicResource SrgInputOutlineBrush}" BorderThickness="2"
                              Tag="fixed-input" AutomationProperties.Name="固定物理输入端点" Click="FixedEndpointClick" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Canvas.Right="18" Canvas.Top="174" Width="132" Height="124" Padding="10"
                        Background="{DynamicResource SrgOutputPanelBrush}" BorderBrush="{DynamicResource SrgOutputBrush}" BorderThickness="1" CornerRadius="9">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="OUTPUT" Classes="srg-text" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="物理设备输出" Classes="srg-muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FixedOutputPortText}" Classes="srg-muted" FontSize="10"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,9,0,0">
                      <Button Classes="srg-endpoint" Width="13" Height="13" Margin="-16,0,8,0"
                              Background="{DynamicResource SrgOutputBrush}" BorderBrush="{DynamicResource SrgOutputOutlineBrush}" BorderThickness="2"
                              Tag="fixed-output" AutomationProperties.Name="固定物理输出端点" Click="FixedEndpointClick" />
                      <Border Grid.Column="1" Height="5" Background="{DynamicResource SrgTrackBrush}" CornerRadius="3" VerticalAlignment="Center">
                        <Border Width="72" HorizontalAlignment="Left" Background="{DynamicResource SrgOutputBrush}" CornerRadius="3" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>

                <Line StartPoint="150,236" EndPoint="1000,236"
                      Stroke="{DynamicResource SrgGridBrush}" StrokeThickness="1" Opacity="0.6" />
                <ItemsControl x:Name="CanvasConnectionLayer" Canvas.Left="0" Canvas.Top="0" ZIndex="4"
                              RenderTransformOrigin="0%,0%"
                              Width="{Binding Bounds.Width, ElementName=EditorCanvas}"
                              Height="{Binding Bounds.Height, ElementName=EditorCanvas}"
                              ItemsSource="{Binding CanvasConnections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Classes="srg-connection-item"
                            ToolTip.Tip="{Binding SourceInstanceId} → {Binding DestinationInstanceId}"
                            AutomationProperties.Name="{Binding SourceInstanceId} 到 {Binding DestinationInstanceId} 的连接">
                        <Path Classes="srg-connection-arrow"
                              Data="{Binding ., Converter={StaticResource ConnectionGeometryConverter}, ConverterParameter=Arrow}"
                              Fill="{DynamicResource SrgOutputBrush}" Stroke="{DynamicResource SrgCanvasBrush}" StrokeThickness="1"
                              IsHitTestVisible="False" />
                        <Path Classes="srg-connection-halo"
                              Data="{Binding ., Converter={StaticResource ConnectionGeometryConverter}}"
                              Stroke="{DynamicResource SrgCanvasBrush}" StrokeThickness="{Binding HaloThickness}"
                              Opacity="{Binding HaloOpacity}" StrokeLineCap="Round" StrokeJoin="Round"
                              IsHitTestVisible="False" />
                        <Path Classes="srg-connection-hover-line"
                              Data="{Binding ., Converter={StaticResource ConnectionGeometryConverter}}"
                              Stroke="{DynamicResource SrgAccentHoverBrush}" StrokeThickness="5"
                              Opacity="0" StrokeLineCap="Round" StrokeJoin="Round" IsHitTestVisible="False" />
                        <Path Classes="srg-connection-hit"
                              Data="{Binding ., Converter={StaticResource ConnectionGeometryConverter}}"
                              Stroke="Transparent" StrokeThickness="{Binding HitTestThickness}"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              PointerEntered="CanvasConnectionPointerEntered"
                              PointerExited="CanvasConnectionPointerExited"
                              PointerPressed="CanvasConnectionPressed" />
                        <Path Classes="srg-connection-line"
                              Data="{Binding ., Converter={StaticResource ConnectionGeometryConverter}}"
                              Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="{Binding StrokeThickness}"
                              Opacity="{Binding StrokeOpacity}" StrokeLineCap="Round" StrokeJoin="Round"
                              IsHitTestVisible="False" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Path x:Name="ConnectionPreviewHalo" Canvas.Left="0" Canvas.Top="0" ZIndex="6"
                      Stroke="{DynamicResource SrgCanvasBrush}" StrokeThickness="10" Opacity="0.9"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      IsVisible="False" IsHitTestVisible="False" />
                <Path x:Name="ConnectionPreviewPath" Canvas.Left="0" Canvas.Top="0" ZIndex="7"
                      Stroke="{DynamicResource SrgAccentHoverBrush}" StrokeThickness="4" Opacity="0.98"
                      StrokeDashArray="6,4" StrokeLineCap="Round" StrokeJoin="Round"
                      IsVisible="False" IsHitTestVisible="False" />
                <Ellipse x:Name="ConnectionPreviewTarget" Canvas.Left="0" Canvas.Top="0" ZIndex="8"
                         Width="18" Height="18" IsVisible="False" IsHitTestVisible="False"
                         Fill="{DynamicResource SrgCanvasBrush}" Stroke="{DynamicResource SrgAccentHoverBrush}"
                         StrokeThickness="3" />

                <ItemsControl x:Name="CanvasNodeLayer" Canvas.Left="0" Canvas.Top="0" ZIndex="8"
                              RenderTransformOrigin="0%,0%"
                              Width="{Binding Bounds.Width, ElementName=EditorCanvas}"
                              Height="{Binding Bounds.Height, ElementName=EditorCanvas}"
                              ItemsSource="{Binding CanvasNodes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                      <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Classes="srg-canvas-node" Width="{Binding Width}" Height="{Binding Height}"
                            Focusable="True" KeyDown="CanvasNodeKeyDown"
                            AutomationProperties.Name="{Binding DisplayName}"
                            AutomationProperties.HelpText="Enter 选择，方向键移动，Shift 加方向键微调，Delete 删除">
                        <Border Padding="11" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}"
                                BorderThickness="1" CornerRadius="10">
                          <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto" Panel.ZIndex="2">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{Binding LabelForeground}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CategoryText}" Classes="srg-muted" FontSize="10" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="•••" Classes="srg-muted" FontSize="12" />
                            </Grid>
                            <ItemsControl Grid.RowSpan="3" ItemsSource="{Binding RuntimeSkinElements}"
                                          IsVisible="{Binding HasSkinElements}" Foreground="{Binding LabelForeground}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                  <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                </Style>
                              </ItemsControl.Styles>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Width="{Binding Width}" Height="{Binding Height}" Background="Transparent"
                                          IsVisible="{Binding !IsRuntimeInteractive}"
                                          BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1" CornerRadius="3">
                                    <Border.RenderTransform>
                                      <RotateTransform Angle="{Binding Rotation}" />
                                    </Border.RenderTransform>
                                    <Grid>
                                      <Ellipse IsVisible="{Binding IsKnob}" Width="{Binding Width}" Height="{Binding Width}"
                                               Fill="{DynamicResource SrgKnobBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Rectangle IsVisible="{Binding IsFader}" Width="8" Height="{Binding Height}"
                                                 Fill="{DynamicResource SrgKnobBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Border IsVisible="{Binding IsSwitch}" Background="{DynamicResource SrgTrackBrush}"
                                              BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="2" CornerRadius="4" />
                                      <Ellipse IsVisible="{Binding IsButton}" Width="{Binding Width}" Height="{Binding Height}"
                                               Fill="{DynamicResource SrgControlBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Ellipse IsVisible="{Binding IsFootswitch}" Width="{Binding Width}" Height="{Binding Height}"
                                               Fill="{DynamicResource SrgControlBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="3" />
                                      <Ellipse IsVisible="{Binding IsLed}" Width="{Binding Width}" Height="{Binding Height}"
                                               Fill="{Binding IndicatorColor}" Stroke="#FFD6D2" StrokeThickness="1" />
                                      <Border IsVisible="{Binding IsConnector}" Background="{DynamicResource SrgInputPanelBrush}"
                                              BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="2" CornerRadius="50" />
                                      <TextBlock Text="{Binding Label}" IsVisible="{Binding IsLabel}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" />
                                      <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsLabel}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="8" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.RowSpan="3" ItemsSource="{Binding Controls}" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" ZIndex="4">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <Canvas />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                  <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                  <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                </Style>
                              </ItemsControl.Styles>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Classes="srg-parameter-chip" Width="{Binding ControlWidth}" Height="{Binding ControlHeight}"
                                          Tag="{Binding}" Click="NodeRuntimeControlClick"
                                          PointerPressed="NodeRuntimeControlPointerPressed"
                                          PointerReleased="NodeRuntimeControlPointerReleased"
                                          PointerWheelChanged="NodeRuntimeControlWheelChanged"
                                          AutomationProperties.Name="{Binding AutomationName}"
                                          AutomationProperties.HelpText="滚轮调整；拨档、按钮和踩钉可直接操作">
                                    <Grid Width="{Binding ControlWidth}" Height="{Binding ControlHeight}">
                                      <Ellipse IsVisible="{Binding IsKnob}" Width="{Binding ControlWidth}" Height="{Binding ControlWidth}"
                                               Fill="{DynamicResource SrgKnobBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Border IsVisible="{Binding IsKnob}" Width="2" Height="11"
                                              Background="{DynamicResource SrgAccentBrush}" VerticalAlignment="Top"
                                              Margin="0,4,0,0" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                          <RotateTransform Angle="{Binding KnobAngle}" />
                                        </Border.RenderTransform>
                                      </Border>
                                      <Border IsVisible="{Binding IsFader}" Width="{Binding ControlWidth}" Height="{Binding ControlHeight}"
                                              Background="{DynamicResource SrgTrackBrush}" BorderBrush="{DynamicResource SrgAccentBrush}"
                                              BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center">
                                        <Canvas Width="{Binding ControlWidth}" Height="{Binding ControlHeight}">
                                          <Border Width="{Binding ControlWidth}" Height="10" Canvas.Top="{Binding FaderThumbTop}"
                                                  Background="{DynamicResource SrgKnobBrush}" BorderBrush="{DynamicResource SrgAccentBrush}"
                                                  BorderThickness="1" CornerRadius="3" />
                                        </Canvas>
                                      </Border>
                                      <Border IsVisible="{Binding IsToggle}" Width="{Binding ControlWidth}" Height="17"
                                              Background="{DynamicResource SrgTrackBrush}" BorderBrush="{DynamicResource SrgAccentBrush}"
                                              BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                        <Canvas Width="{Binding ControlWidth}" Height="17">
                                          <Ellipse Width="12" Height="12" Canvas.Left="{Binding ToggleThumbLeft}" Canvas.Top="2"
                                                   Fill="{DynamicResource SrgAccentBrush}" />
                                        </Canvas>
                                      </Border>
                                      <Ellipse IsVisible="{Binding IsButton}" Width="{Binding ControlWidth}" Height="{Binding ControlWidth}"
                                               Fill="{DynamicResource SrgControlBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="2" />
                                      <Ellipse IsVisible="{Binding IsFootswitch}" Width="{Binding ControlWidth}" Height="{Binding ControlHeight}"
                                               Fill="{DynamicResource SrgControlBrush}" Stroke="{DynamicResource SrgAccentBrush}" StrokeThickness="3" />
                                      <Image IsVisible="{Binding HasImage}" Width="{Binding ControlWidth}" Height="{Binding ControlHeight}"
                                             Source="{Binding ImagePath, Converter={StaticResource SkinImageConverter}}" Stretch="Uniform" />
                                      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding LabelColor}" FontSize="9"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StateText}" Classes="srg-muted" FontSize="8"
                                                   HorizontalAlignment="Center" />
                                      </StackPanel>
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                              <Button Classes="srg-footswitch" Tag="{Binding InstanceId}" Click="NodeFootswitchClick"
                                      IsVisible="{Binding UseDefaultFootswitchPosition}"
                                      ToolTip.Tip="切换旁路 / 启用">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Border Width="22" Height="14" Background="{DynamicResource SrgControlBrush}"
                                          BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1"
                                          CornerRadius="5" Opacity="{Binding FootswitchOpacity}">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SrgAccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <Image IsVisible="{Binding HasFootswitchImage}" Width="22" Height="14"
                                         Source="{Binding FootswitchImagePath, Converter={StaticResource SkinImageConverter}}"
                                         Stretch="Uniform" Opacity="{Binding FootswitchOpacity}" />
                                  <TextBlock Text="{Binding NodeStateText}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                                </StackPanel>
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Classes="srg-muted" FontSize="9" />
                            </Grid>
                            <Canvas Grid.RowSpan="3" IsVisible="{Binding HasCustomFootswitchPosition}" Panel.ZIndex="3">
                              <Button Classes="srg-footswitch" Tag="{Binding InstanceId}" Click="NodeFootswitchClick"
                                      Canvas.Left="{Binding FootswitchCanvasLeft}" Canvas.Top="{Binding FootswitchCanvasTop}"
                                      ToolTip.Tip="切换旁路 / 启用">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Border Width="22" Height="14" Background="{DynamicResource SrgControlBrush}"
                                          BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1"
                                          CornerRadius="5" Opacity="{Binding FootswitchOpacity}">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SrgAccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <Image IsVisible="{Binding HasFootswitchImage}" Width="22" Height="14"
                                         Source="{Binding FootswitchImagePath, Converter={StaticResource SkinImageConverter}}"
                                         Stretch="Uniform" Opacity="{Binding FootswitchOpacity}" />
                                </StackPanel>
                              </Button>
                            </Canvas>
                          </Grid>
                        </Border>
                        <Ellipse Classes="srg-endpoint-candidate" Width="27" Height="27"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-14,0,0,0"
                                 Stroke="{DynamicResource SrgAccentHoverBrush}" StrokeThickness="2" Fill="Transparent"
                                 IsVisible="{Binding IsConnectionDestinationValid}" IsHitTestVisible="False" />
                        <Ellipse Classes="srg-endpoint-candidate" Width="27" Height="27"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-14,0,0,0"
                                 Stroke="{DynamicResource SrgErrorBrush}" StrokeThickness="2" Fill="Transparent"
                                 IsVisible="{Binding IsConnectionDestinationInvalid}" IsHitTestVisible="False" />
                        <Button Classes="srg-endpoint" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="-8,0,0,0" Background="{DynamicResource SrgAccentBrush}"
                                BorderBrush="{DynamicResource SrgAccentOutlineBrush}" BorderThickness="2"
                                Tag="{Binding InstanceId}" AutomationProperties.Name="{Binding InstanceId}"
                                AutomationProperties.HelpText="选择为连接目标" Click="NodeInputEndpointClick" />
                        <Ellipse Classes="srg-endpoint-candidate" Width="27" Height="27"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-14,0"
                                 Stroke="{DynamicResource SrgAccentHoverBrush}" StrokeThickness="2" Fill="Transparent"
                                 IsVisible="{Binding IsConnectionSourceCandidate}" IsHitTestVisible="False" />
                        <Button Classes="srg-endpoint" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,-8,0" Background="{DynamicResource SrgOutputBrush}"
                                BorderBrush="{DynamicResource SrgOutputOutlineBrush}" BorderThickness="2"
                                Tag="{Binding InstanceId}" AutomationProperties.Name="{Binding InstanceId}"
                                PointerPressed="NodeOutputEndpointPointerPressed"
                                AutomationProperties.HelpText="选择为连接来源" Click="NodeOutputEndpointClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="ConnectionToolPanel" Classes="srg-focus-surface" Canvas.Right="14" Canvas.Top="12" ZIndex="16"
                        Background="{DynamicResource SrgOverlayBrush}" BorderBrush="{DynamicResource SrgToolBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="9,7" Width="360" Focusable="True"
                        KeyDown="ConnectionToolKeyDown" AutomationProperties.Name="拓扑连接工具"
                        AutomationProperties.HelpText="Enter 创建连接，Delete 断开选中连接">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ConnectionSelectionText}" Classes="srg-muted" FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,Auto,*">
                      <ComboBox x:Name="ConnectionSourceSelector" Classes="srg-input"
                                ItemsSource="{Binding ConnectionNodeIds}"
                                SelectedItem="{Binding ConnectionSourceNodeId, Mode=TwoWay}"
                                AutomationProperties.Name="连接来源节点"
                                PlaceholderText="来源节点" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="→" Classes="srg-muted" FontSize="13"
                                 Margin="7,0" VerticalAlignment="Center" />
                      <ComboBox x:Name="ConnectionDestinationSelector" Grid.Column="2" Classes="srg-input"
                                ItemsSource="{Binding ConnectionNodeIds}"
                                SelectedItem="{Binding ConnectionDestinationNodeId, Mode=TwoWay}"
                                AutomationProperties.Name="连接目标节点"
                                PlaceholderText="目标节点" FontSize="10" />
                    </Grid>
                    <TextBlock x:Name="ConnectionCandidateStatusText" Text="{Binding ConnectionCandidateStatusText}"
                               Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button x:Name="CanvasConnectButton" Classes="srg-button ghost" Content="创建连接"
                              Command="{Binding ConnectSelectedCommand}" IsEnabled="{Binding CanConnectNodes}" />
                      <Button x:Name="CanvasDisconnectButton" Classes="srg-button ghost" Content="断开选中"
                              Command="{Binding DisconnectSelectedCommand}" IsEnabled="{Binding CanDisconnectNodes}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Canvas.Left="16" Canvas.Bottom="12"
                           Text="模块可拖动 · 连接操作：先点击源输出端点，再点击目标输入端点"
                           Classes="srg-muted" FontSize="10" />
                <Border x:Name="ModuleDragPreview" IsVisible="False" IsHitTestVisible="False"
                        Width="176" Padding="9,6" Background="{DynamicResource SrgInputPanelBrush}"
                        BorderBrush="{DynamicResource SrgAccentBrush}" BorderThickness="1" CornerRadius="7"
                        Canvas.Left="8" Canvas.Top="8" ZIndex="20">
                  <StackPanel Spacing="1">
                    <TextBlock x:Name="ModuleDragPreviewTitle" Classes="srg-text" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="松开鼠标以添加到此位置" Classes="srg-muted" FontSize="9" />
                  </StackPanel>
                </Border>
                <Border Canvas.Right="14" Canvas.Bottom="9" Background="{DynamicResource SrgOverlayBrush}" BorderBrush="{DynamicResource SrgToolBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="9,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Classes="srg-button ghost" Content="−" Click="ZoomOutClick" ToolTip.Tip="缩小画布" />
                    <TextBlock x:Name="CanvasZoomText" Text="100%" Classes="srg-muted" FontSize="10"
                               VerticalAlignment="Center" MinWidth="38" TextAlignment="Center" />
                    <Button Classes="srg-button ghost" Content="＋" Click="ZoomInClick" ToolTip.Tip="放大画布" />
                    <Button Classes="srg-button ghost" Content="适配" Click="FitCanvasClick" ToolTip.Tip="适配全部节点" />
                    <Button Classes="srg-button ghost" Content="定位" Click="FocusSelectedClick" ToolTip.Tip="定位选中节点" />
                    <Button x:Name="CanvasAddModuleButton" Classes="srg-button ghost" Content="＋ 添加模块"
                            Command="{Binding AddModuleCommand}" IsEnabled="{Binding CanAddModule}" />
                  </StackPanel>
                </Border>
              </Canvas>
            </Border>
        </Border>

        <Border x:Name="InspectorPanel" Grid.Column="2" Background="{DynamicResource SrgPanelBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1,0,0,0"
                Padding="15">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="模块检查器" Classes="srg-text" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="拓扑编辑" Classes="srg-muted" FontSize="10" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SrgAccentBrush}">
                  <TextBlock Text="FX" Foreground="{DynamicResource SrgAccentTextBrush}" FontSize="10" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedNode.InstanceId, FallbackValue=未选择效果器}"
                             Classes="srg-text" FontSize="17" />
                  <TextBlock Text="{Binding InspectorTab} · 选择节点后在此编辑" Classes="srg-muted" FontSize="10" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,Auto">
                <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="Whitebox" Classes="srg-muted" FontSize="9" />
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="Float32" Classes="srg-muted" FontSize="9" />
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="99" Padding="7,3">
                  <TextBlock Text="实时" Foreground="{DynamicResource SrgAccentBrush}" FontSize="9" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="ParameterInspectorButton" Grid.Column="0" Classes="srg-button ghost" Content="参数" Tag="参数"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
                <Button x:Name="PortInspectorButton" Grid.Column="1" Classes="srg-button ghost" Content="端口" Tag="端口"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
                <Button x:Name="ResourceInspectorButton" Grid.Column="2" Classes="srg-button ghost" Content="资源" Tag="资源"
                        Click="InspectorTabClick" HorizontalContentAlignment="Center" />
              </Grid>
              <Border IsVisible="{Binding IsPortInspectorVisible}" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="连接端口" Classes="srg-muted" FontSize="10" />
                    <TextBlock Text="{Binding SelectedPortSummary}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                  </Grid>
                  <ItemsControl x:Name="PortInspectorList" ItemsSource="{Binding SelectedPorts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="10,*" Margin="0,2">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource SrgAccentBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Classes="srg-text" FontSize="11"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="ParameterControlsList" IsVisible="{Binding IsParameterInspectorVisible}"
                            ItemsSource="{Binding SelectedParameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="7" Margin="0,3">
                      <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Id}" Classes="srg-muted" FontSize="9" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding NormalizedText}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="9" />
                            <TextBlock Text="{Binding RangeText}" Classes="srg-muted" FontSize="9" />
                          </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="28,*,28,68" Margin="0,5,0,0">
                          <Button Classes="srg-button ghost" Width="28" Height="28" Padding="0" Content="−"
                                  Tag="{Binding Target}" Click="ParameterDecreaseClick"
                                  ToolTip.Tip="减小参数" AutomationProperties.Name="减小参数" />
                          <Slider Grid.Column="1" Classes="srg-slider" MinWidth="48" Margin="5,0"
                                  Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                  SmallChange="{Binding FineStep}" LargeChange="{Binding CoarseStep}"
                                  Value="{Binding Value}" Tag="{Binding Target}" ValueChanged="ParameterSliderChanged"
                                  AutomationProperties.Name="{Binding DisplayName}" />
                          <Button Grid.Column="2" Classes="srg-button ghost" Width="28" Height="28" Padding="0" Content="+"
                                  Tag="{Binding Target}" Click="ParameterIncreaseClick"
                                  ToolTip.Tip="增大参数" AutomationProperties.Name="增大参数" />
                          <TextBox Grid.Column="3" Classes="srg-input" Margin="5,0,0,0" Tag="{Binding Target}"
                                   Text="{Binding ValueText, Mode=OneWay}" KeyDown="ParameterTextBoxKeyDown"
                                   GotFocus="ParameterGotFocus" LostFocus="ParameterLostFocus" ToolTip.Tip="{Binding StepText}"
                                   AutomationProperties.Name="{Binding DisplayName}"
                                   HorizontalContentAlignment="Right" FontSize="11" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Name="InspectorDuplicateButton" Classes="srg-button" Content="复制"
                        Command="{Binding DuplicateSelectedCommand}" IsEnabled="{Binding CanDuplicateSelected}" HorizontalAlignment="Stretch" />
                <Button x:Name="InspectorDeleteButton" Classes="srg-button" Content="删除"
                        Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <Border IsVisible="{Binding IsResourceInspectorVisible}" Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="52,*">
                    <TextBlock Text="来源" Classes="srg-muted" FontSize="10" />
                    <TextBlock x:Name="ResourceKindText" Grid.Column="1" Text="{Binding SelectedResourceKindText}"
                               Classes="srg-text" FontSize="10" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="52,*">
                    <TextBlock Text="路径" Classes="srg-muted" FontSize="10" />
                    <TextBlock x:Name="ResourcePathText" Grid.Column="1" Text="{Binding SelectedResourcePathText}"
                               Classes="srg-text" FontSize="10" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="52,*">
                    <TextBlock Text="状态" Classes="srg-muted" FontSize="10" />
                    <TextBlock x:Name="ResourceStateText" Grid.Column="1" Text="{Binding SelectedResourceStateText}"
                               Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="{Binding ResourceStatus}" Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="导入模块资源" Click="ImportResourceClick" />
                </StackPanel>
              </Border>

              <Expander Classes="srg-expander" Header="音频设备 / 多 ASIO 路由" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <TextBlock x:Name="AsioDeviceStatusText" Text="{Binding AsioDeviceStatusText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AsioRouteText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AsioRouteValidationText}" Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="刷新 ASIO 设备" IsEnabled="{Binding CanRefreshAsio}" Click="RefreshAsioClick" />
                  <TextBlock Text="输入路由（每行可选择不同设备）" Classes="srg-muted" FontSize="9" />
                  <ItemsControl ItemsSource="{Binding AsioInputRoutes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="48,*,72">
                          <TextBlock Text="{Binding DirectionLabel}" Classes="srg-muted" FontSize="9" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DriverOptions}"
                                    SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" FontSize="10" PlaceholderText="选择设备">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" />
                                  <TextBlock Text="{Binding SampleRateText}" Classes="srg-muted" FontSize="9" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox Grid.Column="2" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DeviceChannels}"
                                    SelectedItem="{Binding SelectedDeviceChannel, Mode=TwoWay}" IsEnabled="{Binding CanEditDeviceChannel}" FontSize="10" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="输出路由（第一个输出设备作为主时钟）" Classes="srg-muted" FontSize="9" />
                  <ItemsControl ItemsSource="{Binding AsioOutputRoutes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="48,*,72">
                          <TextBlock Text="{Binding DirectionLabel}" Classes="srg-muted" FontSize="9" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DriverOptions}"
                                    SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" FontSize="10" PlaceholderText="选择设备">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" />
                                  <TextBlock Text="{Binding SampleRateText}" Classes="srg-muted" FontSize="9" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox Grid.Column="2" Margin="4,0,0,0" Classes="srg-input" ItemsSource="{Binding DeviceChannels}"
                                    SelectedItem="{Binding SelectedDeviceChannel, Mode=TwoWay}" IsEnabled="{Binding CanEditDeviceChannel}" FontSize="10" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="打开" IsEnabled="{Binding CanOpenAsio}" Click="OpenAsioClick" />
                    <Button Classes="srg-button" Content="启动" IsEnabled="{Binding CanStartAsio}" Click="StartAsioClick" />
                    <Button Classes="srg-button" Content="停止" IsEnabled="{Binding CanStopAsio}" Click="StopAsioClick" />
                    <Button Classes="srg-button" Content="关闭" IsEnabled="{Binding CanCloseAsio}" Click="CloseAsioClick" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="恢复" IsEnabled="{Binding CanRecoverAsio}" Click="RecoverAsioClick" />
                    <Button Classes="srg-button" Content="{Binding TunerStatus}" IsEnabled="{Binding CanToggleTuner}" Click="ToggleTunerClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding TunerReadout}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>

              <Expander Classes="srg-expander" Header="MIDI 控制" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <TextBlock x:Name="MidiDeviceStatusText" Text="{Binding MidiDeviceStatusText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <Button Classes="srg-button" Content="刷新 MIDI 设备" IsEnabled="{Binding CanRefreshMidi}" Click="RefreshMidiClick" />
                  <ComboBox x:Name="MidiDeviceSelector" Classes="srg-input" ItemsSource="{Binding MidiDevices}"
                            SelectedIndex="{Binding SelectedMidiDeviceIndex, Mode=TwoWay}" IsEnabled="{Binding CanSelectMidiDevice}"
                            PlaceholderText="选择 MIDI 输入">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="打开" IsEnabled="{Binding CanOpenMidi}" Click="OpenMidiClick" />
                    <Button Classes="srg-button" Content="关闭" IsEnabled="{Binding CanCloseMidi}" Click="CloseMidiClick" />
                    <Button Classes="srg-button" Content="排空" IsEnabled="{Binding CanDrainMidi}" Click="DrainMidiClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding MidiLifecycleText}" Classes="srg-muted" FontSize="10" />
                  <TextBlock Text="CC Learn 目标" Classes="srg-muted" FontSize="10" />
                  <ComboBox x:Name="MidiTargetSelector" Classes="srg-input" ItemsSource="{Binding MidiLearnTargets}"
                            SelectedIndex="{Binding SelectedMidiTargetIndex, Mode=TwoWay}" IsEnabled="{Binding MidiOpen}"
                            PlaceholderText="选择要控制的参数">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-text" FontSize="10" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="学习 CC" IsEnabled="{Binding CanArmMidiLearn}" Click="ArmMidiLearnClick" />
                    <Button Classes="srg-button" Content="取消学习" IsEnabled="{Binding CanCancelMidiLearn}" Click="CancelMidiLearnClick" />
                  </StackPanel>
                  <TextBlock Text="{Binding MidiLearnStatus}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10" />
                  <ListBox x:Name="MidiBindingList" Classes="srg-list" Height="82" ItemsSource="{Binding MidiBindings}"
                           SelectedIndex="{Binding SelectedMidiBindingIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayText}" Classes="srg-muted" FontSize="10" TextWrapping="Wrap" /></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="DeleteMidiBindingButton" Classes="srg-button" Content="删除绑定"
                            IsEnabled="{Binding CanDeleteMidiBinding}" Click="DeleteMidiBindingClick" />
                    <Button x:Name="ClearMidiBindingsButton" Classes="srg-button" Content="清空绑定"
                            IsEnabled="{Binding CanClearMidiBindings}" Click="ClearMidiBindingsClick" />
                  </StackPanel>
                  <Button Classes="srg-button" Content="导入 MIDI Bank 目录" Click="ImportMidiBankClick" />
                </StackPanel>
              </Expander>

              <Expander Classes="srg-expander" Header="预设库" IsExpanded="False">
                <StackPanel Spacing="7" Margin="0,8,0,0">
                  <TextBlock Text="显式选择一个目录后，Standalone 会校验其中的 .srig 文件。"
                             Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PresetLibraryDirectoryText}" Classes="srg-muted" FontSize="9"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="srg-button" Content="选择目录" Click="LoadPresetLibraryClick" />
                    <Button Classes="srg-button" Content="刷新" IsEnabled="{Binding CanRefreshPresetLibrary}"
                            Click="RefreshPresetLibraryClick" />
                  </StackPanel>
                  <ListBox x:Name="PresetLibraryList" Classes="srg-list" Height="128"
                           ItemsSource="{Binding PresetLibraryEntries}"
                           SelectedIndex="{Binding SelectedPresetLibraryIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="7" Background="{DynamicResource SrgControlBrush}"
                                BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" Classes="srg-text" FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailText}" Classes="srg-muted" FontSize="9"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button x:Name="PresetLibraryLoadButton" Classes="srg-button primary" Content="加载选中预设"
                          IsEnabled="{Binding CanLoadSelectedPresetLibraryEntry}"
                          Click="LoadSelectedPresetLibraryClick" />
                  <TextBlock Text="Ctrl+PageUp / Ctrl+PageDown 可在已校验的预设间切换。"
                             Classes="srg-muted" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>

              <Border Background="{DynamicResource SrgControlBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <TextBlock Text="C# 界面只负责交互与控制线程；ASIO、MIDI、实时白盒处理由原生后端执行。"
                           Classes="srg-muted" FontSize="10" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource SrgTopbarBrush}" BorderBrush="{DynamicResource SrgBorderBrush}" BorderThickness="0,1,0,0"
              Padding="18,10">
        <Grid ColumnDefinitions="1.15*,1.2*,1.05*,1.1*,1.15*">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="音频引擎" Classes="srg-eyebrow" />
            <TextBlock x:Name="AudioStatusText" Text="{Binding AudioStatus}" Classes="srg-text" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="固定路由" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding AsioRouteText}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="性能 / 延迟" Classes="srg-eyebrow" />
            <TextBlock x:Name="PerformanceText" Text="{Binding PerformanceStatus}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="2">
            <TextBlock Text="MIDI" Classes="srg-eyebrow" />
            <TextBlock Text="{Binding MidiStatus}" Classes="srg-muted" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="2">
            <TextBlock Text="实时白盒" Classes="srg-eyebrow" />
            <TextBlock x:Name="RealtimeStatusText" Text="{Binding RealtimeStatus}" Foreground="{DynamicResource SrgAccentBrush}" FontSize="10"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="WhiteboxStatusText" Text="{Binding WhiteboxStatusText}" Classes="srg-muted" FontSize="9"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
