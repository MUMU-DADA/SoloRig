{
    "version": 2,
    "schema": "circuit",
    "referenceGround": "0",
    "nodes": ["p", "g", "vdd", "0"],
    "ports": [
        {"id": "input", "direction": "input", "node": "g"},
        {"id": "output", "direction": "output", "node": "p"}
    ],
    "supplies": [
        {"id": "vdd", "positive": "vdd", "negative": "0", "voltage": 12.0}
    ],
    "components": [
        {
            "id": "t",
            "type": "triode",
            "pins": ["p", "g", "0"],
            "triodeModel": {
                "kind": "space-charge",
                "modelVersion": 1,
                "amplificationFactor": 100.0,
                "perveance": 0.001,
                "maxCurrent": 0.01,
                "maxStep": 0.5
            }
        },
        {"id": "rp", "type": "resistor", "pins": ["vdd", "p"], "value": 10000.0}
    ],
    "solver": {
        "method": "modified-nodal-analysis",
        "integration": "backward-euler",
        "oversampling": 1,
        "convergence": {
            "maxIterations": 64,
            "absoluteTolerance": 1e-12,
            "relativeTolerance": 1e-12
        }
    }
}
