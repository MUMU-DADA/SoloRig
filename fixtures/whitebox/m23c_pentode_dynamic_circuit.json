{
    "version": 2,
    "schema": "circuit",
    "referenceGround": "0",
    "nodes": ["vdd", "in", "g", "s", "p", "0"],
    "ports": [
        {"id": "input", "direction": "input", "node": "in"},
        {"id": "output", "direction": "output", "node": "p"}
    ],
    "supplies": [
        {"id": "vdd", "positive": "vdd", "negative": "0", "voltage": 24.0}
    ],
    "components": [
        {"id": "rg", "type": "resistor", "pins": ["in", "g"], "value": 1000.0},
        {"id": "cg", "type": "capacitor", "pins": ["g", "0"], "value": 1e-9, "initial": -1.0},
        {
            "id": "power-tube",
            "type": "pentode",
            "pins": ["p", "s", "g", "0"],
            "initial": -1.0,
            "pentodeModel": {
                "kind": "space-charge",
                "modelVersion": 1,
                "screenAmplificationFactor": 20.0,
                "perveance": 0.001,
                "kneeVoltage": 2.0,
                "screenCurrentFraction": 0.1,
                "maxCurrent": 0.01,
                "maxStep": 0.5
            }
        },
        {"id": "rp", "type": "resistor", "pins": ["vdd", "p"], "value": 10000.0},
        {"id": "rs", "type": "resistor", "pins": ["vdd", "s"], "value": 10000.0}
    ],
    "solver": {
        "method": "modified-nodal-analysis",
        "integration": "backward-euler",
        "oversampling": 4,
        "convergence": {
            "maxIterations": 128,
            "absoluteTolerance": 1e-12,
            "relativeTolerance": 1e-12
        }
    }
}
