{
    "version": 2,
    "schema": "circuit",
    "referenceGround": "0",
    "nodes": [
        "in",
        "out",
        "0"
    ],
    "ports": [
        {
            "id": "input",
            "direction": "input",
            "node": "in"
        },
        {
            "id": "output",
            "direction": "output",
            "node": "out"
        }
    ],
    "components": [
        {
            "id": "d",
            "type": "diode",
            "pins": [
                "out",
                "0"
            ],
            "model": "solorig.cleanroom.diode.v1"
        },
        {
            "id": "r",
            "type": "resistor",
            "pins": [
                "in",
                "out"
            ],
            "value": 1000
        }
    ],
    "solver": {
        "method": "modified-nodal-analysis",
        "integration": "backward-euler",
        "oversampling": 1,
        "convergence": {
            "maxIterations": 64,
            "absoluteTolerance": 1.0e-10,
            "relativeTolerance": 1.0e-8
        }
    }
}