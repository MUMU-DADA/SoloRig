{
  "version": 2,
  "schema": "circuit",
  "referenceGround": "0",
  "nodes": ["in", "out", "0"],
  "ports": [
    {"id": "input", "direction": "input", "node": "in"},
    {"id": "output", "direction": "output", "node": "out"}
  ],
  "components": [
    {"id": "series", "type": "resistor", "pins": ["in", "out"], "value": 1000.0},
    {"id": "storage", "type": "capacitor", "pins": ["out", "0"], "value": 1e-9, "initial": 0.0}
  ],
  "solver": {
    "method": "modified-nodal-analysis",
    "integration": "backward-euler",
    "oversampling": 4,
    "convergence": {"maxIterations": 16, "absoluteTolerance": 1e-12, "relativeTolerance": 1e-12}
  }
}
