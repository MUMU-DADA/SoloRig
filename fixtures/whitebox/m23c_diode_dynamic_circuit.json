{
  "version": 2,
  "schema": "circuit",
  "referenceGround": "0",
  "nodes": ["in", "out", "0"],
  "ports": [
    {"id": "input", "direction": "input", "node": "in"},
    {"id": "output", "direction": "output", "node": "out"}
  ],
  "components": [
    {"id": "series", "type": "resistor", "pins": ["in", "out"], "value": 1000.0},
    {"id": "diode", "type": "diode", "pins": ["out", "0"], "initial": 0.1,
     "model": {"kind": "shockley", "saturationCurrent": 1e-12,
               "thermalVoltage": 0.02585, "maxStep": 1.0,
               "junctionCapacitance": 1e-9, "junctionPotential": 0.7,
               "gradingCoefficient": 0.0, "temperatureCelsius": 25.0,
               "leakageCurrent": 0.0, "leakageTemperatureCoefficient": 0.0}}
  ],
  "solver": {
    "method": "modified-nodal-analysis",
    "integration": "backward-euler",
    "oversampling": 4,
    "convergence": {"maxIterations": 64, "absoluteTolerance": 1e-12, "relativeTolerance": 1e-10}
  }
}
