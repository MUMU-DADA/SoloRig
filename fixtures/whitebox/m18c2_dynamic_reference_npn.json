{
  "version": 2,
  "schema": "circuit",
  "referenceGround": "0",
  "nodes": [
    "collector",
    "base",
    "vcc",
    "0"
  ],
  "ports": [
    {
      "id": "input",
      "direction": "input",
      "node": "base"
    },
    {
      "id": "output",
      "direction": "output",
      "node": "collector"
    }
  ],
  "supplies": [
    {
      "id": "vcc",
      "positive": "vcc",
      "negative": "0",
      "voltage": 5.0
    }
  ],
  "components": [
    {
      "id": "rc",
      "type": "resistor",
      "pins": [
        "vcc",
        "collector"
      ],
      "value": 1000.0
    },
    {
      "id": "cc",
      "type": "capacitor",
      "pins": [
        "collector",
        "0"
      ],
      "value": 0.000001,
      "initial": 5.0
    },
    {
      "id": "q",
      "type": "bjt",
      "pins": [
        "collector",
        "base",
        "0"
      ],
      "initial": 0.6,
      "model": "solorig.cleanroom.bjt.npn.v1"
    }
  ],
  "solver": {
    "method": "modified-nodal-analysis",
    "integration": "backward-euler",
    "oversampling": 1,
    "convergence": {
      "maxIterations": 64,
      "absoluteTolerance": 1e-12,
      "relativeTolerance": 1e-9
    }
  }
}